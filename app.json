{
  "expo": {
    "name": "Kroo",
    "slug": "Kroo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kroo",
    "userInterfaceStyle": "automatic",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "url": "https://u.expo.dev/bce30208-bb4d-4f6b-9e4d-2f3eb2d0e051"
    },
    "ios": {
      "bundleIdentifier": "com.krootravel.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "pan",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "backgroundColor": "#042219"
      },
      "newArchEnabled": true,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.krootravel.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kroo to scan a friend's QR code."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kroo to access your photos so you can choose a profile picture.",
          "cameraPermission": "Allow Kroo to use your camera so you can take a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 270,
          "resizeMode": "contain",
          "backgroundColor": "#042219",
          "dark": {
            "backgroundColor": "#042219"
          }
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bce30208-bb4d-4f6b-9e4d-2f3eb2d0e051"
      }
    },
    "owner": "darkhorse9372",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
