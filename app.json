{
  "expo": {
    "name": "Kroo",
    "slug": "Kroo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kroo",
    "userInterfaceStyle": "automatic",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "ios": {
      "bundleIdentifier": "com.krootravel.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "backgroundColor": "#042219"
      },
      "newArchEnabled": true,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.krootravel.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kroo to scan a friend's QR code."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kroo to access your photos so you can choose a profile picture.",
          "cameraPermission": "Allow Kroo to use your camera so you can take a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Kroo to show your position and verify visited places.",
          "locationAlwaysAndWhenInUsePermission": "Allow Kroo to recognize new city and airport arrivals and suggest GPS-verified visits.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 270,
          "resizeMode": "contain",
          "backgroundColor": "#042219",
          "dark": {
            "backgroundColor": "#042219"
          }
        }
      ],
      "expo-asset",
      "expo-iap",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "46f28005-a7f2-4ebd-8725-c96863062837"
      }
    },
    "owner": "darkhorse9372"
  }
}