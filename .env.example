# Android emulator: use http://10.0.2.2:3001 when JSON Server runs on Windows.
# Physical device/WSL: use the reachable LAN or WSL host IP.
EXPO_PUBLIC_API_URL=http://localhost:3001

# RevenueCat public SDK keys. These are platform-specific and safe to bundle.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Backend-only import credentials. Never prefix these with EXPO_PUBLIC_.
RESTCOUNTRIES_API_KEY=
GEONAMES_USERNAME=

# Optional importer pacing controls.
IMPORT_BATCH_SIZE=5
IMPORT_DELAY_MS=1500
